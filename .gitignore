# Operating-system and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
*.swo

# Python environments and caches
.venv/
.venv*/
venv/
env/
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pytype/
.tox/
.nox/
.cache/
.coverage
.coverage.*
htmlcov/

# Packaging artifacts
/build/
/dist/
*.egg-info/
pip-wheel-metadata/

# Generated benchmark data, logs, and download cache
/outputs/
/logs/
/tmp/
*.log
*.part

# Reproducible raw control payloads. These files are downloaded by
# scripts/download_benchmark_controls.sh or generated by the benchmark suite.
# Small provenance files and expert range files remain version-controlled.
/controls/**/*.[Pp][Oo][Ss]
/controls/**/*.[Ee][Pp][Oo][Ss]
/controls/extra/tofsims_15446699_*.txt

# LaTeX build artifacts (the source and generated table fragments are tracked)
/paper/*.aux
/paper/*.bbl
/paper/*.blg
/paper/*.fdb_latexmk
/paper/*.fls
/paper/*.out
/paper/*.pdf
/paper/*.synctex.gz
/paper/*.toc
/paper/_minted-*/
